# Domain Configuration
DOMAIN=md.m-host.si
LE_EMAIL=REPLACE_ME@example.com

# MikroTik Configuration
MT_BASE_URL=https://172.20.50.6
MT_USER=api
MT_PASS=REPLACE_ME
MT_TLS_CA_PATH=/app/certs/mikrotik-ca.crt

# MikroTik Interfaces
LTE_IFACE=lte1
WLAN_IFACE=*6
VXLAN_IFACE=Vxlan

# Polling Configuration
SUMMARY_POLL_SECONDS=3
SUMMARY_STALE_SECONDS=10
REQUEST_TIMEOUT_MS=2000

# Admin Bootstrap
ADMIN_USER=admin
ADMIN_PASS=REPLACE_ME

# Security
JWT_SECRET=REPLACE_ME_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
COOKIE_NAME=md_auth
DB_PASSWORD=REPLACE_ME_STRONG_PASSWORD
